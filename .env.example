# EC2의 /opt/chen-erd/.env 로 복사해서 쓴다. 이 파일에는 비밀 값을 적지 않는다.

# 실행할 이미지 태그. 배포할 때마다 배포 스크립트가 커밋 SHA로 바꿔 적는다.
IMAGE_TAG=latest

# app을 여는 호스트 주소. 비워 두면 80번 포트를 그대로 연다(HTTP).
# APP_PUBLISH=80

# ── HTTPS(도메인이 있을 때) ──────────────────────────────────
# 아래 세 줄의 주석을 함께 풀고 DOMAIN을 실제 도메인으로 바꾼다.
# 도메인의 A 레코드가 이 서버의 공인 IP를 가리키고, 보안 그룹에서 80과 443이 열려 있어야 인증서가 발급된다.
# COMPOSE_PROFILES=https
# DOMAIN=erd.example.com
# APP_PUBLISH=127.0.0.1:8787

# ── 관리자 페이지(서비스 지표) ───────────────────────────────
# 서버 안 127.0.0.1:9000 에만 열린다. 보는 법: 내 컴퓨터에서 scripts/admin-tunnel.sh
# 아래 두 값은 비밀이다. 이 예시 파일이 아니라 서버의 .env에만 적는다.
#
# 비밀번호 해시: 내 컴퓨터에서 node scripts/admin-password.mjs 로 만든 값(작은따옴표로 감싼다. $가 들어 있다).
# 없으면 관리자 페이지에 아무도 로그인할 수 없다.
# ADMIN_PASSWORD_HASH='scrypt$32768$8$1$...$...'
#
# 익명 ID와 방 id를 해시하는 솔트: openssl rand -hex 32
# 없으면 서버가 처음 켤 때 만들어 데이터 볼륨(/data/stats/salt)에 둔다. 한 번 정하면 바꾸지 않는다(바꾸면 사람 구분이 끊긴다).
# STATS_SALT=
