# EC2의 /opt/chen-erd/.env 로 복사해서 쓴다. 이 파일에는 비밀 값을 적지 않는다.

# 실행할 이미지 태그. 배포할 때마다 배포 스크립트가 커밋 SHA로 바꿔 적는다.
IMAGE_TAG=latest

# app을 여는 호스트 주소. 비워 두면 80번 포트를 그대로 연다(HTTP).
# APP_PUBLISH=80

# ── HTTPS(도메인이 있을 때) ──────────────────────────────────
# 아래 세 줄의 주석을 함께 풀고 DOMAIN을 실제 도메인으로 바꾼다.
# 도메인의 A 레코드가 이 서버의 공인 IP를 가리키고, 보안 그룹에서 80과 443이 열려 있어야 인증서가 발급된다.
# COMPOSE_PROFILES=https
# DOMAIN=erd.example.com
# APP_PUBLISH=127.0.0.1:8787
